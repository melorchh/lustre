{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60
    }
  },
  "regions": ["sin1"],
  "routes": [
    { "src": "/lustre-backend/(.*)", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "status": 404 },
    { "src": "/([^/]+\\.php)", "dest": "/api/router.php?page=$1" },
    { "src": "/", "dest": "/api/router.php?page=index.php" }
  ]
}
