{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60
    }
  },
  "regions": ["sin1"],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "routes": [
    { "src": "/lustre-backend/(.*)", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "status": 404 },
    { "src": "/([^/]+\\.php)", "dest": "/api/router.php?page=$1" },
    { "src": "/", "dest": "/api/router.php?page=index.php" }
  ]
}
