{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.8.0",
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "regions": ["sin1"],
  "routes": [
    { "src": "/toddcare-backend/(.*)", "status": 404 },
    { "handle": "filesystem" },
    { "src": "/([^/]+\\.php)", "dest": "/api/$1" },
    { "src": "/", "dest": "/api/index.php" }
  ]
}