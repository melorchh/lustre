# MedExpert v6 - environment variables
# Copy to a Vercel Project -> Settings -> Environment Variables (Production/Preview).
# For local XAMPP dev: copy values into toddcare-backend/env.local.php (gitignored).

# --- Supabase Postgres (pooler, Transaction mode) ---
DB_HOST=
DB_PORT=6543
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require

# --- Gmail SMTP (App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=

# --- Groq AI chatbot (server-side proxy) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Cron / reminders guard ---
CRON_SECRET=